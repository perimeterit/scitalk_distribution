
<header role="banner" class="site-header bg-color--primary">

  {% block site_header %}
    {# Header blocks are here. Assume this is branding + search #}
  {% endblock %}

  <div class="dark-mode-toggle">
    {{ drupal_block('dark_mode_toggle') }}
  </div>
  
  <div class="menu-toggle-wrapper">
    {{ include('cosmos:toggle_button', {
      name: 'Menu',
      controls: 'main-nav',
      icon_name: 'menu-bars',
      button_style: 'unstyled'
    }) }}
  </div>

</header>
