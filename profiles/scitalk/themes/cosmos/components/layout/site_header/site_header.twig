
<header role="banner" class="site-header bg-color--primary">

  {% block site_branding %}
  {% endblock %}

  {% block site_search %}
  {% endblock %}

  <div class="supplementary-nav">
    {# Additional header nav, including dark mode buttons #}
    {% block supplementary_nav %}
    {% endblock %}
  </div>

  <div class="menu-toggle-wrapper">
    {{ include('cosmos:toggle_button', {
      name: 'Menu',
      controls: 'main-nav',
      icon_name: 'menu-bars',
      button_style: 'unstyled'
    }) }}
  </div>

</header>
