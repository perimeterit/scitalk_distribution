{{ include('cosmos:skip_link', {
  content_element: '#main-content',
  link_text: 'Skip to main content'
}) }}

<div class="page-layout">

  {% embed "cosmos:site_header" %}
    {% block site_branding %}
      {{ site_branding }}
    {% endblock %}

    {% block site_search %}
      {{ site_search }}
    {% endblock %}

    {% block supplementary_nav %}
      {{ supplementary_nav }}
    {% endblock %}
  {% endembed %}

  <aside class="main-nav" id="main-nav">

    {{ include('cosmos:toggle_button', {
      name: 'Close Menu',
      controls: 'main-nav',
      icon_name: 'chevron-right'
    }) }}

    <div class="main-nav-container">
      {# Show search button #}
      {{ include('cosmos:toggle_button', {
        name: 'Advanced Search',
        icon_name: 'advanced-search',
        display_label: true,
        controls: 'advanced-search'
      }, with_context = false) }}

      {# Close search button #}
      {{ include('cosmos:toggle_button', {
        name: 'Close Advanced Search',
        icon_name: 'close-x',
        controls: 'advanced-search'
      }, with_context = false) }}

      {# Advanced search component #}
      {{ include("cosmos:advanced_search") }}

      {# Main menu #}
      {{ drupal_menu('main', expand=true) }}

    </div>

    {# Sidebar region #}
    <div class="main-nav-blocks">
      {% block sidebar_region %}
        {{ drupal_region('sidebar')}}
      {% endblock %}
    </div>

  </aside>

  {# Main content area #}
  <main role="main" class="main-content">
    <a id="main-content" tabindex="-1"></a>

    <header class="main-banner">
      {% block page_title_region %}
        {{ drupal_region('banner') }}
      {% endblock %}
    </header>

    <div class="main-content-wrapper">
      {% block main_content %}
      {% endblock %}
    </div>
  </main>

  {# Footer #}
  {% embed "cosmos:site_footer" %}
    {% block footer_main %}
      {{ site_footer_main }}
    {% endblock %}

    {% block footer_bottom %}
      {{ site_footer_bottom }}
    {% endblock %}
  {% endembed %}

</div>

{{ include( base_path ~ '/themes/custom/cosmos/components/element/icon/icons.svg')}}
