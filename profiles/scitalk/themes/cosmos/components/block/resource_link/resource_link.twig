
<div{{ attributes.addClass('resource-link') }}>
  <span class="resource-link--icon resource-link--icon-{{ resource_type|clean_class }}">
    {% if resource_type in ['file','remote_file'] %}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="4 2 19 20" fill="currentColor"><path d="M3 9H9C9.55228 9 10 8.55228 10 8V2H20.0017C20.5531 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5511 3 20.9925V9ZM3 7L8 2.00318V7H3Z"></path></svg>
    {% endif %}
    <span class="icon-label">
      {{ icon_label }}
    </span>
  </span>

  <span class="resource-link--text">
    {% if title_prefix %}
      <span class="resource-link--title-prefix">{{ title_prefix }}</span>
    {% endif %}

    <a href="{{ link }}">
      {{ title }}
    </a>

    {% if title_suffix %}
      <span class="resource-link--title-suffix">{{ title_suffix }}</span>
    {% endif %}

  </span>
</div>
