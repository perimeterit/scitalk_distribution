{% set display_label = display_label|default(false) %}
{% set icon_name = icon_name|default('chevron-down') %}


{% set classes = [
   name|clean_class ~ '-toggle',
  'toggle-button',
  button_style != 'default' ? 'button-' ~ button_style|clean_class,
  icon_name ? 'with-icon'
] %}

<button {{ attributes.addClass(classes)}} aria-controls="{{ controls }}"
  aria-expanded="false" data-hide-text="{{ hide_text|default('Hide '|t ~ name)  }}">
  {% if icon_name %}
    {{ include('cosmos:icon', {icon_name: icon_name}) }}
  {% endif %}

  {% if display_label == false %}
    <span class="{{ display_label == false  ? 'visually-hidden' }} ">
  {% endif %}

    {{ name }}

  {% if display_label == false %}
    </span>
  {% endif %}

</button>
