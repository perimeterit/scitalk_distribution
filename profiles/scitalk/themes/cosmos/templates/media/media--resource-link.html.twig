{#
/**
 * @file
 * Theme override to display a media item.
 * Resource link is the view mode.
 *
 * Available variables:
 * - name: Name of the media.
 * - content: Media content.
 *
 * @see template_preprocess_media()
 *
 * @ingroup themeable
 */
#}
{% set classes = [
  'resource-link',
  'resource--' ~ bundle,
]
%}

{% set title_prefix = null %}
{% set title_suffix = null %}

{# set the component prop values for each resource type #}
{% set resource_type = bundle %}
{% set title = name %}

{% if resource_type == 'arxiv' %}
  {% set link = 'http://arxiv.org/abs/' ~ content.field_media_scitalk_arxiv['#items'].0.value %}
  {% set link_attributes = {target: '_blank'} %}
  {% set icon_label = 'ArXiv' %}
  {% set title_prefix = content.field_media_scitalk_arxiv %}

{% elseif resource_type == 'file' %}
  {% set file_name = content.field_media_file.0['#file'].getFileName() %}
  {% set file_extension = file_name|split('.')|last %}
  {% set icon_label = file_extension %}

  {# Get file size  #}
  {% set file_bytes = content.field_media_file.0['#file'].getSize() %}
  {% if file_bytes > 1024 %}
    {% set filesize = (file_bytes / 1024)|number_format(1, '.') ~ 'mb'  %}
  {% else %}
    {% set filesize = file_bytes ~ 'kb' %}
  {% endif %}

  {% set title_suffix = filesize %}

{% elseif resource_type == 'image' %}
  {% set image_uri = content.field_media_image['#items'].0.entity.getFileUri() %}
  {% set link =  file_url(image_uri) %}
  {% set title = name %}

{% elseif resource_type == 'remote_file' %}
  {% set file_name = content.field_media_scitalk_remote_file['#items'].0.value|split('/')|last %}
  {% set file_extension = file_name|split('.')|last %}
  {% set link = content.field_media_scitalk_remote_file['#items'].0.value %}
  {% set link_attributes = {target: '_blank'} %}
  {% set icon_label = file_extension %}

{% elseif resource_type == 'doi' %}
  {% set link = 'http://doi.org/' ~ content.field_media_scitalk_doi['#items'].0.value %}
  {% set icon_label = resource_type %}
  {% set title_prefix = 'DOI: ' ~ content.field_media_scitalk_doi['#items'].0.value %}
{% else %}
  {% set icon_label = bundle %}
{% endif %}

{% if resource_type == 'image' %}
  {{ include("cosmos:resource_image_link") }}
{% else %}
  {{ include("cosmos:resource_link") }}
{% endif %}
