{#
/**
 * @file
 * Cosmos theme implementation for an 'input' #type form element.
 * Include the search icon as an svg so the colour can be adjusted
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 *
 * @ingroup themeable
 */
#}
{% embed "cosmos:search_submit" %}
  {% block search_input %}
    <input{{ attributes }} />{{ children }}
  {% endblock %}
{% endembed %}
