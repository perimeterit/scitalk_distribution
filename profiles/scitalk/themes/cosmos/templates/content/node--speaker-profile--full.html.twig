{#
/**
 * @file
 * Custom theme implementation to display a node.
 *
 * @ingroup themeable
 */
#}

{% embed "cosmos:speaker_profile" with ({
  speaker_name: label,
  profile_content: content.field_sp_speaker_profile.0,
  profile_url: content.field_sp_web_profile_url.0['#url']
 }) %}
   {% block speaker_image %}
     {{ content.field_sp_profile_thumbnail }}
   {% endblock %}
{% endembed %}

