{#
/**
 * @file
 * Theme implementation to display a Talk node.
 * Builds the metadata array and merges taxonomy terms into one array
 * This can be extended by other view modes that need to render the metadata component
 *
 * @ingroup themeable
 */
#}


{% set talk_date = content.field_talk_date|render %}

{# Merge the taxonomy terms #}
{% set talk_type_terms = content.field_talk_type['#items'] %}
{% set talk_subject_terms = content.field_talk_subject['#items'] %}

{% set taxonomy_ids = [] %}
{# Get these into arrays of just the term ids #}
{# Talk type only has one value #}
{% if talk_type_terms is not empty %}
  {% set taxonomy_ids = [talk_type_terms.target_id] %}
{% endif %}

{% if talk_subject_terms is not empty %}
  {% for term in talk_subject_terms %}
    {% set taxonomy_ids = taxonomy_ids|merge([term.target_id]) %}
  {% endfor %}
{% endif %}

{% set metadata = {
  date: talk_date,
  number: content.scitalk_prefixed_talk_number['#items'].0.value,
  taxonomy: taxonomy_ids,
} %}

{% if view_mode == 'horizontal_card'%}
  {% set variant = 'horizontal' %}
{% elseif view_mode == 'teaser' %}
  {% set variant = 'teaser' %}
{% endif %}

{% block talk_component %}

  {% embed "cosmos:card" with ({
    variant: variant|default('horizontal'),
    image_display: 'foreground',
    title: label,
    link: url,
    heading_level: 3,
    speakers,
    metadata,
  }) %}

    {% block card_fg_image %}
      {{ content.field_talk_thumbnail }}
    {% endblock %}
    {% block content %}
      {{ content.field_talk_abstract }}
    {% endblock %}
  {% endembed %}

{% endblock %}
