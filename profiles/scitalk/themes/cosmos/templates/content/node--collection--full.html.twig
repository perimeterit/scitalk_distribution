{#
/**
 * @file
 * Custom theme implementation to display a node.
 *
 * @ingroup themeable
 */
#}

{% extends "@cosmos/content/node--collection.html.twig" %}

{% block collection_component %}
  <article{{ attributes.addClass(classes) }}>

    {{ include('cosmos:metadata', {
      date: collection_date,
      count,
      number: content.field_collection_number['#items'].0.value,
      taxonomy: taxonomy_ids
    }, with_context = false) }}

    {{ content|without('links', 'field_collection_number','field_parent_collection', 'field_collection_number_children','field_collection_number_of_talks', 'field_collection_date','field_collection_subject','field_collection_type') }}

    {{ drupal_view('scitalk_talks_in_collection','card_view') }}

  </article>
{% endblock %}
